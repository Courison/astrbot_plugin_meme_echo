{
  "enable": {
    "description": "启用插件",
    "type": "bool",
    "hint": "插件总开关，关闭后所有复读行为停止",
    "default": true
  },
  "text_reread_enable": {
    "description": "开启文本复读",
    "type": "bool",
    "hint": "是否复读纯文本消息",
    "default": false
  },
  "text_reread_probability": {
    "description": "文本复读概率",
    "type": "float",
    "hint": "文本复读概率（0.0 - 1.0），默认 0.1 即 10%",
    "default": 0.1
  },
  "image_reread_enable": {
    "description": "开启普通图片复读",
    "type": "bool",
    "hint": "是否复读普通图片（有查看原图/下载入口的图片）",
    "default": true
  },
  "image_reread_probability": {
    "description": "普通图片复读概率",
    "type": "float",
    "hint": "普通图片复读概率（0.0 - 1.0），默认 0.1 即 10%",
    "default": 0.1
  },
  "sticker_reread_enable": {
    "description": "开启表情包复读",
    "type": "bool",
    "hint": "是否复读表情包（点击后无查看原图/下载入口的图片）",
    "default": true
  },
  "sticker_reread_probability": {
    "description": "表情包复读概率",
    "type": "float",
    "hint": "表情包复读概率（0.0 - 1.0），默认 0.3 即 30%",
    "default": 0.3
  },
  "keyword_blacklist": {
    "description": "复读关键词黑名单",
    "type": "list",
    "hint": "消息文本中包含任一项时不复读（不区分大小写），例如：接龙、投票、https://",
    "default": []
  },
  "group_whitelist": {
    "description": "群聊白名单",
    "type": "list",
    "hint": "只有列表中的群号才会触发复读，留空表示对所有群聊生效（私聊默认不触发）",
    "default": []
  }
}